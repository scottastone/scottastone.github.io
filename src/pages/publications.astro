---
import Base from "../layouts/Base.astro";
import PubList from "../components/PubList.astro";
import { site, getPublications } from "../lib/data";

const pubs = await getPublications();
const years = [...new Set(pubs.map((p) => p.data.year))];
const page = site.publications;
---

<Base title={page.title} description={page.description ?? undefined}>
  <header class="page-head">
    <h1>{page.title}</h1>
    {page.intro && <p class="muted">{page.intro.replaceAll("{count}", String(pubs.length))}</p>}
  </header>
  {years.map((y) => (
    <section class="year-group">
      <h2 class="year">{y}</h2>
      <PubList pubs={pubs.filter((p) => p.data.year === y)} showYear={false} />
    </section>
  ))}
</Base>
