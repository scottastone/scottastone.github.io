---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { site, getPosts } from "../../lib/data";

const posts = await getPosts();
const page = site.writing;
---

<Base title={page.title} description={page.description ?? undefined}>
  <header class="page-head">
    <h1>{page.title}</h1>
    <p class="muted">{page.intro} <a href="/rss.xml">RSS</a></p>
  </header>
  {posts.length ? <PostList posts={posts} /> : <p class="muted">{page.empty}</p>}
</Base>
